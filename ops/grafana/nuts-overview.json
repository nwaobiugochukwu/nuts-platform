    {
      "id": 4,
      "type": "stat",
      "title": "Broker connections up",
      "description": "1 = every process reaches RabbitMQ.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "min(nuts_rabbitmq_up)",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": true
