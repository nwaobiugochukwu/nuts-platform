# ==============================================================================
# NUTS Commerce — Server Environment Example
# ==============================================================================
# Copy to .env and fill in real values. Never commit secrets.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001

# ─── CORS & Cookies ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# In production set to your root domain, e.g. .nuts-commerce.com (with leading dot)
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# ─── Account Lifecycle ────────────────────────────────────────────────────────
ACCOUNT_DELETION_GRACE_DAYS=60

# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Transaction-mode pooler — used by the runtime (pgBouncer, IPv4-only)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler — used by Prisma CLI migrations only (direct, no pgBouncer)
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

PRISMA_SLOW_QUERY_MS=500

# pg-pool tuning (applies via driver adapter, not Prisma connection_limit)
DB_CONNECTION_LIMIT=10
DB_IDLE_TIMEOUT_MS=300000
DB_POOL_TIMEOUT=15
DB_KEEPALIVE_MS=240000
RABBITMQ_ENABLED=true
# Local: the container from docker-compose.db.yml. Staging: your hosted broker's
# amqps:// URL with a non-guest user. Every program holds ONE connection to it.
RABBITMQ_URL=amqp://nuts:nuts_local_dev@localhost:5672

# ─── Redis (Redis Cloud, Upstash or any managed Redis) ───────────────
# Use the rediss:// (TLS) URL from your provider's dashboard. Every program holds
# 1 connection (the api also holds a 2nd, for live notifications).
REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Min 32 characters each. JWT_ACCESS_SECRET is also accepted as an alias.
JWT_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=nuts
JWT_ACCESS_AUDIENCE=nuts-api
JWT_REFRESH_AUDIENCE=nuts-api

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_TTL_MIN=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60
OTP_PEPPER=change-me-otp-pepper-secret-min-32-chars-long

# ─── Payments (Paystack) ──────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=change-me-paystack-secret-key
PAYSTACK_CALLBACK_URL=https://your-storefront.example.com/order-success
# Configure this URL in the Paystack Dashboard, not as an API environment variable:
# https://your-api.example.com/api/v1/payments/webhook
DEFAULT_CURRENCY=ngn

# ─── Email delivery (Brevo transactional API) ──────────────────────────────────
EMAIL_FROM="NUTS Commerce <verified-sender@example.com>"
BREVO_API_KEY=your_brevo_api_key

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=nuts-commerce

# ─── Referrals & Checkout ─────────────────────────────────────────────────────
REFERRAL_DISCOUNT_AMOUNT=500
CHECKOUT_REVALIDATE_PRICES=true

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_SETUP_SECRET=change-me-admin-setup-secret-min-32-chars-long

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=

# ─── Dev Tools ────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SWAGGER_ENABLED=true

# Inventory reservation TTL for unpaid orders in minutes (default: 15, valid: 5-120)
UNPAID_ORDER_TTL_MINUTES=15

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Web Client ID from Google Cloud Console (Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"

# ==============================================================================
# Programs, ports and monitoring
# ==============================================================================
# The API image runs as separate programs. See docs/architecture/how-it-works.md.
#
#   all     everything in one process. THE DEFAULT when PM2_APP is unset, so a service
#           nobody has configured keeps working as before the split.
#   api     HTTP requests, login, checkout, live notification streams
#   worker  queue consumers (emails, notifications, analytics, stock, audit) + outbox relay
#   jobs    scheduled jobs. Run EXACTLY ONE copy of this program.
#
# Local development: `npm run dev` starts api, worker and jobs as separate programs,
# so you do not set PM2_APP yourself.
# Staging / Render: set PM2_APP on each service (not a secret, you type the word):
#   api service -> PM2_APP=api      worker service -> PM2_APP=worker      jobs service -> PM2_APP=jobs
# Under PM2 the role comes from PM2_APP; PROCESS_ROLE is set by the PM2 file. Do not set both.
# PM2_APP=all

# --- Health ports (the worker and jobs programs have no HTTP API of their own) ---
# Not secrets: plain port numbers. A per-program value lets this one local file serve every
# program; on a deployed service set only HEALTH_PORT. Defaults shown.
# WORKER_HEALTH_PORT=3002
# JOBS_HEALTH_PORT=3003
# TEMPORAL_WORKER_HEALTH_PORT=3004
# HEALTH_PORT=                     # single-service form (Render/compose)

# --- Metrics (Prometheus) ---
# Local development turns metrics on by default: api 9464, worker 9465, jobs 9466,
# temporal worker 9467 (read them at http://localhost:<port>/metrics). Staging exposes
# NOTHING until you set a port. Never publish a metrics port to the internet.
# API_METRICS_PORT=9464
# WORKER_METRICS_PORT=9465
# JOBS_METRICS_PORT=9466
# METRICS_PORT=                    # single-service form
# SECRET: the token a scraper must send as "Authorization: Bearer <token>".
# Generate with: openssl rand -base64 32
# METRICS_TOKEN=

# --- PM2 tuning (all optional) ---
# PM2_API_INSTANCES=1              # >1 runs the api in cluster mode (needs spare CPUs)
# PM2_MAX_MEMORY=600M              # restart a program gracefully above this memory
# PM2_KILL_TIMEOUT_MS=30000        # time allowed to finish work on stop/redeploy

# ==============================================================================
# Connection budget (matters with hosted Supabase / Redis / RabbitMQ)
# ==============================================================================
# Every program loads the whole app, so each one has its own connections:
#   database  up to DB_CONNECTION_LIMIT per program
#   redis     1 per program (+1 for the api's live-notification subscriber)
#   rabbitmq  1 per program
# Three programs with the default pool of 15 could open 45 database connections.
# Staging suggestion, set per service in Render: api 10, worker 5, jobs 3.
# Compare the total against your Supabase, Redis and broker plan limits.
# DB_CONNECTION_LIMIT=10           # shown above; set a smaller value on worker and jobs

# ==============================================================================
# Temporal (durable workflows). Off by default: nothing uses it yet.
# ==============================================================================
# TEMPORAL_ENABLED=false           # "true" turns it on
# TEMPORAL_ADDRESS=localhost:7233  # Temporal Cloud: <namespace>.<account>.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=nuts-dev      # nuts-dev | nuts-staging
# SECRET (Temporal Cloud only, created in your Temporal account): enables TLS.
# TEMPORAL_API_KEY=
# TEMPORAL_TASK_QUEUES=            # comma list; default: all five
# TEMPORAL_METRICS_PORT=9467       # the Temporal worker's own metrics port
