{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@common/*": ["./src/common/*"],
      "@infra/*": ["./src/infrastructure/*"],
      "@infrastructure/*": ["./src/infrastructure/*"],
      "@modules/*": ["./src/modules/*"],
      "@api/common/search/*": ["./src/modules/search/*"],
      "@api/common/audit-log/*": ["./src/common/audit-log/*", "./src/modules/security/audit/*"],
      "@api/common/*": ["./src/common/*"],
      "@api/infrastructure/*": ["./src/infrastructure/*"],
      "@api/modules/shared/*": ["./src/common/*"],
      "@api/modules/infrastructure/*": ["./src/infrastructure/*"],
      "@api/modules/auth/*": ["./src/modules/auth/*"],
      "@api/modules/users/*": ["./src/modules/users/*"],
      "@api/modules/vendors/*": ["./src/modules/vendors/*"],
      "@api/modules/creators/*": ["./src/modules/vendors/*"],
      "@api/modules/admin/*": ["./src/modules/admin/*"],
      "@api/modules/products/*": ["./src/modules/products/*"],
      "@api/modules/categories/*": ["./src/modules/categories/*"],
      "@api/modules/category/*": ["./src/modules/categories/*"],
      "@api/modules/product-variants/*": ["./src/modules/products/*"],
      "@api/modules/cart/*": ["./src/modules/cart/*"],
      "@api/modules/checkout/cart/*": ["./src/modules/cart/*"],
      "@api/modules/checkout/orders/*": ["./src/modules/orders/*"],
      "@api/modules/checkout/*": ["./src/modules/cart/*"],
      "@api/modules/orders/*": ["./src/modules/orders/*"],
      "@api/modules/discounts/*": ["./src/modules/discounts/*"],
      "@api/modules/promotions/*": ["./src/modules/discounts/*"],
      "@api/modules/payments/*": ["./src/modules/payments/*"],
      "@api/modules/wallets/*": ["./src/modules/wallets/*"],
      "@api/modules/wallet/*": ["./src/modules/wallets/*"],
      "@api/modules/reviews/*": ["./src/modules/reviews/*"],
      "@api/modules/wishlists/*": ["./src/modules/wishlists/*"],
      "@api/modules/wishlist/*": ["./src/modules/wishlists/*"],
      "@api/modules/referrals/*": ["./src/modules/referrals/*"],
      "@api/modules/referral/*": ["./src/modules/referrals/*"],
      "@api/modules/analytics/*": ["./src/modules/analytics/*"],
      "@api/modules/search/*": ["./src/modules/search/*"],
      "@api/modules/upload/*": ["./src/modules/upload/*"],
      "@api/modules/notifications/*": ["./src/modules/notifications/*"],
      "@api/modules/security/*": ["./src/modules/security/*"],
      "@api/modules/health/*": ["./src/modules/health/*"],
      "@api/modules/*": ["./src/modules/*"],
      "@api/*": ["./src/*"]
    },
    "isolatedModules": false,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "incremental": true,
    "strictPropertyInitialization": false,
    "types": ["jest", "node"]
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}