{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@api/*": ["./src/*"]
    },
    "isolatedModules": false,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "incremental": true,
    "strictPropertyInitialization": false,
    "types": ["jest", "node"]
  },
  "exclude": [
    "node_modules",
    "dist"
  ]
}