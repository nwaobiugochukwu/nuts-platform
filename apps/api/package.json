{
  "name": "@nuts/api",
  "version": "0.0.1",
  "description": "NUTS Backend Modular API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});for(const f of fs.readdirSync('.'))if(f.endsWith('.tsbuildinfo'))fs.rmSync(f,{force:true})\"",
    "prebuild": "npm run clean",
    "build": "node ../../node_modules/@typescript/native/lib/tsc.js -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run start:prod",
    "predev": "npm run build",
    "compile": "node ../../node_modules/@typescript/native/lib/tsc.js -p tsconfig.build.json",
    "dev:compile": "node ../../node_modules/@typescript/native/lib/tsc.js -p tsconfig.build.json --watch --preserveWatchOutput --incremental false",
    "dev": "cross-env PM2_HOME=./.pm2/dev pm2-runtime ecosystem.dev.config.cjs --only tsc,api,worker,jobs",
    "dev:api": "node scripts/wait-for-dist.mjs dist/main.js && cross-env PM2_HOME=./.pm2/api pm2-runtime ecosystem.dev.config.cjs --only api",
    "dev:worker": "node scripts/wait-for-dist.mjs dist/worker.js && cross-env PM2_HOME=./.pm2/worker pm2-runtime ecosystem.dev.config.cjs --only worker",
    "dev:jobs": "node scripts/wait-for-dist.mjs dist/worker.js && cross-env PM2_HOME=./.pm2/jobs pm2-runtime ecosystem.dev.config.cjs --only jobs",
    "dev:single": "cross-env PM2_HOME=./.pm2/single pm2-runtime ecosystem.dev.config.cjs --only tsc,all",
    "dev:role": "npm run compile && cross-env PM2_HOME=./.pm2/role sh -c 'pm2-runtime ecosystem.dev.config.cjs --only tsc,$DEV_LABEL'",
    "typecheck": "node ../../node_modules/@typescript/native/lib/tsc.js --noEmit",
    "prestart:debug": "npm run build",
    "start:debug": "cross-env PM2_HOME=./.pm2/debug pm2-runtime ecosystem.dev.config.cjs --only tsc,debug",
    "start:worker": "cross-env NODE_ENV=production PROCESS_ROLE=worker TS_NODE_PROJECT=tsconfig.runtime.json node --max-old-space-size=350 -r tsconfig-paths/register dist/worker",
    "start:jobs": "cross-env NODE_ENV=production PROCESS_ROLE=jobs TS_NODE_PROJECT=tsconfig.runtime.json node --max-old-space-size=350 -r tsconfig-paths/register dist/worker",
    "dlq": "node scripts/dlq.mjs",
    "pm2:api": "pm2-runtime ecosystem.config.cjs --only api",
    "pm2:worker": "pm2-runtime ecosystem.config.cjs --only worker",
    "pm2:jobs": "pm2-runtime ecosystem.config.cjs --only jobs",
    "pm2:temporal-worker": "pm2-runtime ecosystem.config.cjs --only temporal-worker",
    "start:prod": "cross-env NODE_ENV=production TS_NODE_PROJECT=tsconfig.runtime.json node --max-old-space-size=350 -r tsconfig-paths/register dist/main",
    "prestart:staging": "cross-env NODE_ENV=staging npm run migrate:deploy",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest && npm run test:workflows",
    "test:workflows": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testRegex \".*\\\\.workflow\\\\.spec\\\\.ts$\" --testPathIgnorePatterns /node_modules/",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "cross-env NODE_OPTIONS=--inspect-brk jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate:deploy": "prisma migrate deploy --schema=../../packages/database/schema.prisma",
    "migrate:status": "prisma migrate status --schema=../../packages/database/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema=../../packages/database/schema.prisma",
    "db:generate": "prisma generate --schema=../../packages/database/schema.prisma",
    "docker:dev": "docker compose --profile dev up --build",
    "docker:prod": "docker compose --profile prod up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "start:dev": "npm run dev",
    "start:staging": "cross-env NODE_ENV=staging TS_NODE_PROJECT=tsconfig.runtime.json node --max-old-space-size=350 -r tsconfig-paths/register dist/main",
    "test:ci": "jest --coverage --coverageReporters=text-summary && npm run test:workflows"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.12",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.12",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.12",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nestjs": "^11.1.0",
    "@sentry/profiling-node": "^11.1.0",
    "@temporalio/client": "1.27.0",
    "@temporalio/worker": "1.27.0",
    "@temporalio/workflow": "1.27.0",
    "amqplib": "^2.2.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "cockatiel": "^4.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^11.3.3",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.0",
    "multer": "^2.5.0",
    "nanoid": "^3.3.20",
    "nestjs-pino": "^4.6.1",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "pm2": "7.1.2",
    "prom-client": "15.1.3",
    "redlock": "^5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.18.2",
    "tsconfig-paths": "^4.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^10.0.2",
    "@nestjs/testing": "^11.0.1",
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@temporalio/testing": "1.27.0",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prisma": "^7.10.1",
    "supertest": "^7.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "\\.workflow\\.spec\\.ts$"
    ],
    "transformIgnorePatterns": [
      "node_modules[\\\\/](?!(cockatiel|htmlparser2|domhandler|domutils|domelementtype|dom-serializer|entities)[\\\\/])"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest",
        {
          "jsc": {
            "target": "es2022",
            "parser": {
              "syntax": "typescript",
              "decorators": true
            },
            "transform": {
              "legacyDecorator": true,
              "decoratorMetadata": true
            }
          },
          "module": {
            "type": "commonjs"
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@api/(.*)$": "<rootDir>/$1"
    },
    "coverageThreshold": {
      "global": {
        "statements": 42,
        "branches": 29,
        "functions": 30,
        "lines": 42
      },
      "./src/infrastructure/messaging/outbox/": {
        "statements": 90,
        "branches": 90,
        "functions": 90,
        "lines": 90
      },
      "./src/modules/referrals/": {
        "statements": 90,
        "branches": 90,
        "functions": 90,
        "lines": 90
      },
      "./src/modules/audit/": {
        "statements": 90,
        "branches": 80,
        "functions": 85,
        "lines": 90
      },
      "./src/common/request-context/": {
        "statements": 90,
        "branches": 85,
        "functions": 90,
        "lines": 90
      },
      "./src/infrastructure/database/transaction-runner.ts": {
        "statements": 80,
        "branches": 75,
        "functions": 70,
        "lines": 80
      },
      "./src/infrastructure/messaging/rabbitmq/": {
        "statements": 50,
        "branches": 50,
        "functions": 70,
        "lines": 50
      },
      "./src/modules/analytics/consumers/": {
        "statements": 90,
        "branches": 85,
        "functions": 90,
        "lines": 90
      },
      "./src/modules/products/consumers/": {
        "statements": 90,
        "branches": 85,
        "functions": 90,
        "lines": 90
      },
      "./src/modules/notifications/consumers/": {
        "statements": 90,
        "branches": 85,
        "functions": 90,
        "lines": 90
      },
      "./src/infrastructure/messaging/events/": {
        "statements": 90,
        "branches": 90,
        "functions": 90,
        "lines": 90
      }
    }
  }
}
