{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testTimeout": 30000,
  "testRegex": ".e2e-spec.ts$",
  "transformIgnorePatterns": ["node_modules[\\\\/](?!cockatiel[\\\\/])"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "@swc/jest",
      {
        "jsc": {
          "target": "es2022",
          "parser": { "syntax": "typescript", "decorators": true },
          "transform": { "legacyDecorator": true, "decoratorMetadata": true }
        },
        "module": { "type": "commonjs" }
      }
    ]
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^@common/(.*)$": "<rootDir>/../src/common/$1",
    "^@infra/(.*)$": "<rootDir>/../src/infrastructure/$1",
    "^@infrastructure/(.*)$": "<rootDir>/../src/infrastructure/$1",
    "^@modules/(.*)$": "<rootDir>/../src/modules/$1",
    "^@api/common/search/(.*)$": "<rootDir>/../src/modules/search/$1",
    "^@api/common/audit-log/(.*)$": "<rootDir>/../src/common/audit-log/$1",
    "^@api/common/(.*)$": "<rootDir>/../src/common/$1",
    "^@api/infrastructure/(.*)$": "<rootDir>/../src/infrastructure/$1",
    "^@api/modules/shared/(.*)$": "<rootDir>/../src/common/$1",
    "^@api/modules/infrastructure/(.*)$": "<rootDir>/../src/infrastructure/$1",
    "^@api/modules/auth/(.*)$": "<rootDir>/../src/modules/auth/$1",
    "^@api/modules/users/(.*)$": "<rootDir>/../src/modules/users/$1",
    "^@api/modules/vendors/(.*)$": "<rootDir>/../src/modules/vendors/$1",
    "^@api/modules/creators/(.*)$": "<rootDir>/../src/modules/vendors/$1",
    "^@api/modules/admin/(.*)$": "<rootDir>/../src/modules/users/$1",
    "^@api/modules/products/(.*)$": "<rootDir>/../src/modules/products/$1",
    "^@api/modules/categories/(.*)$": "<rootDir>/../src/modules/categories/$1",
    "^@api/modules/category/(.*)$": "<rootDir>/../src/modules/categories/$1",
    "^@api/modules/product-variants/(.*)$": "<rootDir>/../src/modules/products/$1",
    "^@api/modules/cart/(.*)$": "<rootDir>/../src/modules/cart/$1",
    "^@api/modules/checkout/cart/(.*)$": "<rootDir>/../src/modules/cart/$1",
    "^@api/modules/checkout/orders/(.*)$": "<rootDir>/../src/modules/orders/$1",
    "^@api/modules/checkout/(.*)$": "<rootDir>/../src/modules/cart/$1",
    "^@api/modules/orders/(.*)$": "<rootDir>/../src/modules/orders/$1",
    "^@api/modules/discounts/(.*)$": "<rootDir>/../src/modules/discounts/$1",
    "^@api/modules/promotions/(.*)$": "<rootDir>/../src/modules/discounts/$1",
    "^@api/modules/payments/(.*)$": "<rootDir>/../src/modules/payments/$1",
    "^@api/modules/wallets/(.*)$": "<rootDir>/../src/modules/wallets/$1",
    "^@api/modules/wallet/(.*)$": "<rootDir>/../src/modules/wallets/$1",
    "^@api/modules/reviews/(.*)$": "<rootDir>/../src/modules/reviews/$1",
    "^@api/modules/wishlists/(.*)$": "<rootDir>/../src/modules/wishlists/$1",
    "^@api/modules/wishlist/(.*)$": "<rootDir>/../src/modules/wishlists/$1",
    "^@api/modules/referrals/(.*)$": "<rootDir>/../src/modules/referrals/$1",
    "^@api/modules/referral/(.*)$": "<rootDir>/../src/modules/referrals/$1",
    "^@api/modules/analytics/(.*)$": "<rootDir>/../src/modules/analytics/$1",
    "^@api/modules/search/(.*)$": "<rootDir>/../src/modules/search/$1",
    "^@api/modules/upload/(.*)$": "<rootDir>/../src/modules/upload/$1",
    "^@api/modules/notifications/(.*)$": "<rootDir>/../src/modules/notifications/$1",
    "^@api/modules/security/(.*)$": "<rootDir>/../src/modules/security/$1",
    "^@api/modules/health/(.*)$": "<rootDir>/../src/modules/health/$1",
    "^@api/modules/(.*)$": "<rootDir>/../src/modules/$1",
    "^@api/(.*)$": "<rootDir>/../src/$1"
  }
}
