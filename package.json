{
  "name": "nuts-commerce",
  "version": "1.0.0",
  "private": true,
  "description": "NUTS Commerce — Multi-vendor enterprise e-commerce platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run db:up && turbo run dev",
    "dev:turbo": "turbo run dev",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "db:studio": "prisma studio --schema=packages/database/schema.prisma",
    "dev:down": "docker compose --profile dev down",
    "dev:logs": "docker compose --profile dev logs -f",
    "dev:logs:api": "docker compose --profile dev logs -f api",
    "dev:logs:web": "docker compose --profile dev logs -f client",
    "prod": "docker compose --profile prod up -d --build",
    "prod:down": "docker compose --profile prod down",
    "prod:logs": "docker compose --profile prod logs -f",
    "build:api": "npm run --prefix apps/api build",
    "build:web": "npm run --prefix apps/web build",
    "lint:api": "npm run --prefix apps/api lint",
    "lint:web": "npm run --prefix apps/web lint",
    "lint": "npm run lint:api && npm run lint:web",
    "typecheck:api": "npm run --prefix apps/api typecheck",
    "typecheck:web": "npm run --prefix apps/web typecheck",
    "typecheck": "npm run typecheck:api && npm run typecheck:web",
    "test:api": "npm run --prefix apps/api test",
    "test": "npm run test:api",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:lockfile": "cross-env npm_config_allow_scripts=\"\" npm ci --dry-run",
    "postinstall": "node scripts/postinstall.js",
    "db:generate": "npm run --prefix apps/api db:generate",
    "db:seed": "node --experimental-strip-types packages/database/scripts/seed.ts",
    "migrate:deploy": "npm run --prefix apps/api migrate:deploy",
    "migrate:status": "npm run --prefix apps/api migrate:status",
    "migrate:dev": "npm run --prefix apps/api migrate:dev",
    "build": "docker compose build",
    "dev:docker": "docker compose --profile dev up --build",
    "dev:backend": "npm run --prefix apps/api dev",
    "dev:api": "cross-env PROCESS_ROLE=api DEV_LABEL=api npm run --prefix apps/api dev:role",
    "dev:worker": "cross-env PROCESS_ROLE=worker DEV_ENTRY=dist/worker.js DEV_LABEL=worker npm run --prefix apps/api dev:role",
    "dev:jobs": "cross-env PROCESS_ROLE=jobs DEV_ENTRY=dist/worker.js DEV_LABEL=jobs npm run --prefix apps/api dev:role",
    "dev:single": "npm run --prefix apps/api dev:single",
    "dev:web": "npm run --prefix apps/web dev",
    "dev:logs:worker": "docker compose --profile dev logs -f worker",
    "dev:logs:jobs": "docker compose --profile dev logs -f jobs",
    "obs:up": "docker compose --profile observability up -d prometheus grafana",
    "obs:down": "docker compose --profile observability stop prometheus grafana",
    "temporal:up": "docker compose --profile dev up -d temporal",
    "temporal:down": "docker compose --profile dev stop temporal",
    "dlq": "npm run --prefix apps/api dlq --",
    "verify:deploy": "sh scripts/verify-deploy.sh",
    "staging": "docker compose --profile staging up -d --build",
    "staging:down": "docker compose --profile staging down",
    "staging:ps": "docker compose --profile staging ps",
    "staging:logs": "docker compose --profile staging logs -f",
    "prod:ps": "docker compose --profile prod ps",
    "prod:docker": "docker compose --profile prod up -d --build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "turbo": "^2.11.5"
  },
  "packageManager": "npm@11.17.0",
  "prisma": {
    "schema": "packages/database/schema.prisma"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "bcrypt": true,
    "@swc/core": true,
    "unrs-resolver": true,
    "@sentry/node-cpu-profiler": true,
    "msgpackr-extract": true,
    "@nestjs/core": true,
    "@scarf/scarf": true
  }
}
