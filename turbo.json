{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:compile": { "cache": false, "persistent": true },
    "dev:api": { "cache": false, "persistent": true },
    "dev:worker": { "cache": false, "persistent": true },
    "dev:jobs": { "cache": false, "persistent": true },
    "dev:web": { "cache": false, "persistent": true }
  }
}
